# Placeholders only. Copy to .env and fill in locally. Never commit .env.

# PostgreSQL used by docker compose (the database container and the migration step)
POSTGRES_USER=pathly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pathly
# Optional host ports (defaults: 5432 and 8000)
# POSTGRES_PORT=5432
# BACKEND_PORT=8000

# Connection string used when the backend runs on your machine instead of in docker compose
DATABASE_URL=postgresql://pathly:change-me@localhost:5432/pathly
# Optional: separate database for tests (defaults to DATABASE_URL; tests use their own schema)
# TEST_DATABASE_URL=postgresql://pathly:change-me@localhost:5432/pathly

JWT_SECRET=change-me
LLM_API_KEY=your-llm-api-key
EMAIL_API_KEY=your-email-api-key
